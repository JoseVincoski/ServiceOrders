{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:80"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ServiceOrdersApi",
    "Audience": "ServiceOrdersApi",
    "SecretKey": "SuperSecretKeyWithAtLeast32Characters!", //In production, this key should be stored using a secure method to store and retrieve the secret key
    "ExpirationInMinutes": 1440
  }
}
